---
import { asLocale, localizePath, ui } from '../lib/i18n';

const locale = asLocale(Astro.currentLocale);

const navLinks = [
  { label: ui('nav.cases', locale), href: localizePath('/#section-ai', locale) },
  { label: ui('nav.lab', locale), href: localizePath('/lab/', locale) },
  { label: ui('nav.resume', locale), href: localizePath('/resume/', locale) },
  { label: ui('nav.about', locale), href: localizePath('/#case-about', locale) },
  { label: ui('nav.contact', locale), href: localizePath('/#case-contact', locale) },
];

const enLabel = ui('header.langEnglish', locale);
const deLabel = ui('header.langGerman', locale);
const taglineLabel = ui('header.tagline', locale);
---

<header class="site-header">
  <a class="brand-link" href={localizePath('/', locale)} aria-label="Scott Gerstl | Home">
    <img class="brand-img" src="/wordmark.svg" alt="Scott Gerstl" />
  </a>
  <span class="tagline">{taglineLabel}</span>
  <nav class="nav">
    {navLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <span class="lang-divider" aria-hidden="true">|</span>
    <span class="lang-toggle" role="group" aria-label="Language">
      <a
        class:list={['lang-link', locale === 'en' && 'lang-link--active']}
        href="/"
        data-lang-link="en"
        aria-current={locale === 'en' ? 'true' : undefined}
      >{enLabel}</a>
      <span class="lang-sep" aria-hidden="true">·</span>
      <a
        class:list={['lang-link', locale === 'de' && 'lang-link--active']}
        href="/de/"
        data-lang-link="de"
        aria-current={locale === 'de' ? 'true' : undefined}
      >{deLabel}</a>
    </span>
  </nav>
</header>

<script>
  import { smoothScrollTo } from '../lib/scroll';

  const HEADER_OFFSET = 80;

  let controller: AbortController | null = null;

  function scrollToHash(hash: string) {
    if (!hash || hash === '#') return false;
    let el: Element | null = null;
    try {
      el = document.querySelector(hash);
    } catch {
      return false;
    }
    if (!el) return false;
    const r = (el as HTMLElement).getBoundingClientRect();
    smoothScrollTo(window.scrollY + r.top - HEADER_OFFSET);
    return true;
  }

  // Switch the locale-prefixed equivalent of the current path. The toggle's
  // own href is just / or /de/; this overrides it so the click lands on the
  // same page in the other locale (preserving hash + query).
  function buildSwitchPath(targetLocale: 'en' | 'de'): string {
    const path = location.pathname.replace(/^\/de(\/|$)/, '/');
    const base = targetLocale === 'en' ? path : (path === '/' ? '/de/' : `/de${path}`);
    return base + location.search + location.hash;
  }

  function setLocaleCookie(loc: 'en' | 'de') {
    // 1 year; SameSite=Lax so external referrals still surface the
    // Accept-Language fallback for first-time visitors who came from outside.
    document.cookie = `pref-locale=${loc}; Path=/; Max-Age=31536000; SameSite=Lax`;
  }

  function init() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    // Hash-link scroll (same-page anchor jumps)
    document.querySelectorAll<HTMLAnchorElement>('.site-header .nav a').forEach((a) => {
      a.addEventListener(
        'click',
        (e) => {
          // Language toggles handled separately below
          if (a.dataset.langLink) return;
          const url = new URL(a.href, location.href);
          if (url.origin !== location.origin) return;
          if (!url.hash) return;
          if (url.pathname !== location.pathname) return;
          e.preventDefault();
          history.replaceState(null, '', url.pathname + url.hash);
          scrollToHash(url.hash);
        },
        { signal },
      );
    });

    // Language toggle: set cookie, navigate to the same-page equivalent in the
    // target locale.
    document.querySelectorAll<HTMLAnchorElement>('.site-header [data-lang-link]').forEach((a) => {
      a.addEventListener(
        'click',
        (e) => {
          const target = a.dataset.langLink as 'en' | 'de' | undefined;
          if (!target) return;
          e.preventDefault();
          setLocaleCookie(target);
          location.assign(buildSwitchPath(target));
        },
        { signal },
      );
    });

    const brand = document.querySelector<HTMLAnchorElement>('.site-header .brand-link');
    if (brand) {
      brand.addEventListener(
        'click',
        (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey) return;
          const url = new URL(brand.href, location.href);
          if (url.pathname !== location.pathname) return;
          e.preventDefault();
          if (location.hash) history.replaceState(null, '', location.pathname);
          smoothScrollTo(0);
        },
        { signal },
      );
    }

    if (location.hash) {
      const hash = location.hash;
      window.scrollTo(0, 0);
      requestAnimationFrame(() => requestAnimationFrame(() => scrollToHash(hash)));
    }
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: rgba(246, 246, 246, 0.55);
    backdrop-filter: blur(18px) saturate(170%);
    -webkit-backdrop-filter: blur(18px) saturate(170%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    z-index: 100;
    display: flex;
    align-items: center;
    padding: 0 32px;
    gap: 32px;
  }

  .brand-link {
    display: block;
    transition: opacity 0.15s ease;
  }

  .brand-link:hover {
    opacity: 0.7;
  }

  .brand-img {
    height: 44px;
    width: auto;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .tagline {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 15px;
    color: var(--color-text-soft);
    letter-spacing: 0.01em;
    margin-left: 8px;
  }

  .nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav a {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: opacity 0.15s ease;
  }

  .nav a:hover {
    opacity: 0.6;
  }

  .lang-divider {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: var(--color-text-soft);
    opacity: 0.4;
    user-select: none;
  }

  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .lang-link {
    opacity: 0.5;
  }

  .lang-link--active {
    opacity: 1;
  }

  .lang-link:hover {
    opacity: 0.8;
  }

  .lang-link--active:hover {
    opacity: 1;
  }

  .lang-sep {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: var(--color-text-soft);
    user-select: none;
  }

  @media (max-width: 767px) {
    .site-header {
      padding: 0 16px;
      gap: 12px;
    }

    .brand-img {
      height: 32px;
    }

    .tagline {
      display: none;
    }

    .nav {
      gap: 14px;
    }

    .nav a {
      font-size: 12px;
    }

    .lang-divider {
      font-size: 12px;
    }

    .lang-sep {
      font-size: 12px;
    }
  }
</style>
