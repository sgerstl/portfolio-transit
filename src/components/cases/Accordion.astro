---
---

<script>
  import { smoothScrollTo } from '../../lib/scroll';

  const TRANSITION_MS = 420;

  let controller: AbortController | null = null;
  let currentCards: HTMLElement[] = [];

  function tickSpineDuring(durationMs: number) {
    const start = performance.now();
    function tick(now: number) {
      window.dispatchEvent(new Event('spine:redraw'));
      if (now - start < durationMs) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  function openCard(card: HTMLElement) {
    currentCards.forEach((other) => {
      if (other !== card && other.classList.contains('case-card--open')) {
        closeCard(other);
      }
    });
    card.classList.add('case-card--open');
    card.querySelector('.case-toggle')?.setAttribute('aria-expanded', 'true');
    const body = card.querySelector<HTMLElement>('.case-body');
    if (!body) return;
    // Collapsed bodies are inert so keyboard focus can't land on hidden links.
    body.inert = false;
    body.style.maxHeight = body.scrollHeight + 'px';

    const onEnd = (e: TransitionEvent) => {
      if (e.propertyName !== 'max-height') return;
      body.style.maxHeight = 'none';
      body.removeEventListener('transitionend', onEnd);
      window.dispatchEvent(new Event('spine:redraw'));
      const cardRect = card.getBoundingClientRect();
      smoothScrollTo(window.scrollY + cardRect.top - 80);
    };
    body.addEventListener('transitionend', onEnd);

    tickSpineDuring(TRANSITION_MS);
  }

  function closeCard(card: HTMLElement) {
    const body = card.querySelector<HTMLElement>('.case-body');
    if (!body) return;
    body.style.maxHeight = body.scrollHeight + 'px';
    void body.offsetHeight;
    body.style.maxHeight = '0px';
    body.inert = true;
    card.classList.remove('case-card--open');
    card.querySelector('.case-toggle')?.setAttribute('aria-expanded', 'false');
    tickSpineDuring(TRANSITION_MS);
  }

  function init() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    currentCards = Array.from(
      document.querySelectorAll<HTMLElement>('.case-card'),
    ).filter((card) => card.querySelector('.case-body'));

    currentCards.forEach((card) => {
      const header = card.querySelector<HTMLElement>('.case-header');
      if (!header) return;
      header.addEventListener(
        'click',
        (e) => {
          // The case name is a real link to the case page; let it navigate.
          if ((e.target as HTMLElement).closest('a')) return;
          e.preventDefault();
          if (card.classList.contains('case-card--open')) {
            closeCard(card);
          } else {
            openCard(card);
          }
        },
        { signal },
      );
    });

    window.addEventListener(
      'case:open',
      (e) => {
        const slug = (e as CustomEvent<{ slug: string }>).detail?.slug;
        if (!slug) return;
        const card = document.getElementById(`case-${slug}`);
        if (!card) return;
        if (card.classList.contains('case-card--open')) {
          const r = card.getBoundingClientRect();
          smoothScrollTo(window.scrollY + r.top - 80);
          return;
        }
        if (currentCards.includes(card)) {
          openCard(card);
        } else {
          const r = card.getBoundingClientRect();
          smoothScrollTo(window.scrollY + r.top - 80);
        }
      },
      { signal },
    );

    // A #case-* hash (the header's About and Contact links) opens and scrolls to that card. Coming back from a case
    // page no longer scrolls anywhere: the back link goes back in history, and the router restores the reader's own
    // scroll position (2026-10-09; the old referrer check animated a scroll that overrode it).
    // Station cards need nothing: the anchor jump lands them under the header (scroll-margin-top in global.css).
    if (window.location.hash.startsWith('#case-')) {
      const slug = window.location.hash.slice('#case-'.length);
      const card = document.getElementById(`case-${slug}`);
      if (card && currentCards.includes(card)) {
        window.dispatchEvent(new CustomEvent('case:open', { detail: { slug } }));
      }
    }
  }

  document.addEventListener('astro:page-load', init);
</script>
