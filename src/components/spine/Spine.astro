---
const RAIL_CENTER_X = 126;
const ARROW_W = 25;
const ARROW_H = 24;
// Starts well above the page, so an overscroll bounce at the top never
// shows the end of the rail. Nothing above the page can be scrolled to.
const RAIL_TOP_Y = -1000;
---

<svg class="spine-svg" id="spine" aria-hidden="true">
  <rect
    class="spine-rail-track"
    id="spine-rail-track"
    x={RAIL_CENTER_X - 3}
    y={RAIL_TOP_Y}
    width="6"
    height="586"
  />
  <g class="spine-arrow" id="spine-arrow" transform="translate(113.5, 642)">
    <rect class="spine-arrow-tile" width={ARROW_W} height={ARROW_H} rx="4" />
    <path
      class="spine-arrow-glyph"
      d="M11.16 5 L13.81 5 L13.84 5 L13.84 13.75 L19 8.34 L19 12.18 L12.5 19 L6 12.18 L6 8.31 L11.16 13.72 L11.16 5 Z"
    />
  </g>
  <path class="spine-branch-line spine-branch-line--pro" id="spine-branch-pro" d=""></path>
  <path class="spine-branch-line spine-branch-line--indie" id="spine-branch-indie" d=""></path>
  <path class="spine-branch-line spine-branch-line--pers" id="spine-branch-pers" d=""></path>
  <rect class="spine-line-terminator spine-line-terminator--pro" id="spine-term-pro" rx="4" width="14" height="8" />
  <rect class="spine-line-terminator spine-line-terminator--indie" id="spine-term-indie" rx="4" width="14" height="8" />
  <rect class="spine-line-terminator spine-line-terminator--pers" id="spine-term-pers" rx="4" width="14" height="8" />
  <rect class="spine-line-indicator spine-line-indicator--pro" id="spine-ind-pro" rx="4" width="28" height="8" />
  <rect class="spine-line-indicator spine-line-indicator--indie" id="spine-ind-indie" rx="4" width="22" height="8" />
  <rect class="spine-line-indicator spine-line-indicator--pers" id="spine-ind-pers" rx="4" width="8" height="8" />
</svg>

<script>
  const DEFAULT_RAIL_CENTER_X = 126;
  const ARROW_W = 25;
  const ARROW_H = 24;
  const RAIL_TOP_Y = -1000;

  type SectionKey = 'pro' | 'indie' | 'pers';

  let controller: AbortController | null = null;
  let resizeObserver: ResizeObserver | null = null;

  function buildBranchPath(startX: number, startY: number, endX: number, endY: number): string {
    const dx = endX - startX;
    const dy = endY - startY;
    if (dx < 24) {
      const verticalEnd = endY - 6;
      return `M ${startX} ${startY} V ${verticalEnd} Q ${startX} ${endY} ${startX + 6} ${endY} H ${endX}`;
    }
    const horizontalApproach = Math.max(20, Math.min(dx * 0.30, 80));
    const remainingDx = dx - horizontalApproach;
    const diagonal = Math.max(20, Math.min(remainingDx, dy * 0.55, 220));
    const verticalEnd = endY - diagonal;
    const diagonalEndX = startX + diagonal;
    return `M ${startX} ${startY} V ${verticalEnd} L ${diagonalEndX} ${endY} H ${endX}`;
  }

  function computeVerticalEnd(startX: number, startY: number, endX: number, endY: number): number {
    const dx = endX - startX;
    const dy = endY - startY;
    if (dx < 24) return endY - 6;
    const horizontalApproach = Math.max(20, Math.min(dx * 0.30, 80));
    const remainingDx = dx - horizontalApproach;
    const diagonal = Math.max(20, Math.min(remainingDx, dy * 0.55, 220));
    return endY - diagonal;
  }

  function init() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    resizeObserver?.disconnect();
    resizeObserver = null;

    const svg = document.getElementById('spine') as SVGSVGElement | null;
    if (!svg) return;
    const spineContainer = svg.parentElement as HTMLElement | null;
    if (!spineContainer) return;

    const arrowGroup = document.getElementById('spine-arrow') as SVGGElement | null;
    const track = document.getElementById('spine-rail-track') as SVGRectElement | null;
    if (!arrowGroup || !track) return;

    const linePaths: Record<SectionKey, SVGPathElement | null> = {
      pro: document.getElementById('spine-branch-pro') as SVGPathElement | null,
      indie: document.getElementById('spine-branch-indie') as SVGPathElement | null,
      pers: document.getElementById('spine-branch-pers') as SVGPathElement | null,
    };
    const lineTerminators: Record<SectionKey, SVGRectElement | null> = {
      pro: document.getElementById('spine-term-pro') as SVGRectElement | null,
      indie: document.getElementById('spine-term-indie') as SVGRectElement | null,
      pers: document.getElementById('spine-term-pers') as SVGRectElement | null,
    };
    const lineIndicators: Record<SectionKey, SVGRectElement | null> = {
      pro: document.getElementById('spine-ind-pro') as SVGRectElement | null,
      indie: document.getElementById('spine-ind-indie') as SVGRectElement | null,
      pers: document.getElementById('spine-ind-pers') as SVGRectElement | null,
    };

    const getRailCenterX = () => {
      const val = getComputedStyle(spineContainer)
        .getPropertyValue('--rail-center-x')
        .trim();
      const parsed = val ? parseFloat(val) : NaN;
      return Number.isFinite(parsed) ? parsed : DEFAULT_RAIL_CENTER_X;
    };

    const sizeSpineSvg = () => {
      const cw = spineContainer.offsetWidth;
      const ch = spineContainer.offsetHeight;
      svg.setAttribute('viewBox', `0 0 ${cw} ${ch}`);
      svg.setAttribute('width', String(cw));
      svg.setAttribute('height', String(ch));
    };

    const placeSpineGeometry = () => {
      const railCenterX = getRailCenterX();
      track.setAttribute('x', String(railCenterX - 3));
      // The rail ends at a transfer station level with the bottom of the
      // hero headline, which leaves the branch lines a long run down past
      // the work tiles. Measured in the container's own space.
      let arrowTop = 642;
      const title = document.querySelector<HTMLElement>('.hero .hvf-h1');
      if (title) {
        arrowTop = title.getBoundingClientRect().bottom - ARROW_H - spineContainer.getBoundingClientRect().top;
      }
      arrowGroup.setAttribute('transform', `translate(${railCenterX - ARROW_W / 2}, ${arrowTop})`);

      const trackBottom = arrowTop + ARROW_H / 2;
      track.setAttribute('y', String(RAIL_TOP_Y));
      track.setAttribute('height', String(trackBottom - RAIL_TOP_Y));
    };

    const regenerateBranchLines = () => {
      const railCenterX = getRailCenterX();
      const sectionHeaders: Record<SectionKey, HTMLElement | null> = {
        pro: document.getElementById('section-pro'),
        indie: document.getElementById('section-indie'),
        pers: document.getElementById('section-pers'),
      };

      const containerRect = spineContainer.getBoundingClientRect();
      const arrowTransform = arrowGroup.getAttribute('transform') ?? '';
      const match = arrowTransform.match(/translate\(\s*[0-9.]+\s*,\s*([0-9.]+)\s*\)/);
      const arrowY = match ? parseFloat(match[1]) : 642;
      const lineStartY = arrowY + ARROW_H;

      const startXs: Record<SectionKey, number> = {
        pro: railCenterX - 8,
        indie: railCenterX,
        pers: railCenterX + 8,
      };

      const verticalEnds: Partial<Record<SectionKey, number>> = {};

      (['pro', 'indie', 'pers'] as const).forEach((key) => {
        const headerEl = sectionHeaders[key];
        const path = linePaths[key];
        const term = lineTerminators[key];
        if (!headerEl || !path || !term) return;
        const r = headerEl.getBoundingClientRect();
        const endX = r.left - containerRect.left;
        const endY = r.top - containerRect.top + r.height / 2;
        path.setAttribute('d', buildBranchPath(startXs[key], lineStartY, endX, endY));
        term.setAttribute('x', String(endX - 7));
        term.setAttribute('y', String(endY - 4));
        verticalEnds[key] = computeVerticalEnd(startXs[key], lineStartY, endX, endY);
      });

      const MARKER_H = 8;
      const MARKER_OFFSET = 8;

      if (lineIndicators.pro && verticalEnds.pro !== undefined) {
        const w = 28;
        const center = (startXs.pro + startXs.pers) / 2;
        lineIndicators.pro.setAttribute('x', String(center - w / 2));
        lineIndicators.pro.setAttribute('y', String(verticalEnds.pro - MARKER_H - MARKER_OFFSET));
      }
      if (lineIndicators.indie && verticalEnds.indie !== undefined) {
        const w = 22;
        const center = (startXs.indie + startXs.pers) / 2;
        lineIndicators.indie.setAttribute('x', String(center - w / 2));
        lineIndicators.indie.setAttribute('y', String(verticalEnds.indie - MARKER_H - MARKER_OFFSET));
      }
      if (lineIndicators.pers && verticalEnds.pers !== undefined) {
        const w = 8;
        lineIndicators.pers.setAttribute('x', String(railCenterX + 8 - w / 2));
        lineIndicators.pers.setAttribute('y', String(verticalEnds.pers - MARKER_H - MARKER_OFFSET));
      }
    };

    // At rest the rail ends at the transfer station. The branch lines, each
    // led by its end cap as a train, leave it the moment you scroll and grow
    // 1.5px per pixel scrolled, so they run ahead of the reader and reach
    // each section by the time it is on screen. Vertical travel costs its
    // full distance and horizontal travel half, so the run into a section
    // header draws on rather than snapping across. Reduced motion gets the
    // lines fully drawn.
    type Reveal = { path: SVGPathElement; total: number; lens: number[]; costs: number[]; dockX: number; dockY: number };
    const LEAD = 1.5; // line growth per pixel scrolled, so it leads the page
    let reveals: Partial<Record<SectionKey, Reveal>> = {};
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const revealOn = () => !!document.querySelector('.hero') && !reducedMotion.matches;

    const measureReveals = () => {
      reveals = {};
      (['pro', 'indie', 'pers'] as const).forEach((key) => {
        const path = linePaths[key];
        if (!path || !path.getAttribute('d')) return;
        const total = path.getTotalLength();
        if (!total) return;
        const lens: number[] = [];
        const costs: number[] = [];
        let prev = path.getPointAtLength(0);
        let cost = prev.y;
        for (let l = 0; l <= total; l += 6) {
          const p = path.getPointAtLength(l);
          cost += Math.max(Math.abs(p.y - prev.y), 0.5 * Math.abs(p.x - prev.x));
          lens.push(l);
          costs.push(cost);
          prev = p;
        }
        lens.push(total);
        costs.push(cost + 1);
        // Where the end cap docks, as regenerateBranchLines placed it.
        const term = lineTerminators[key];
        const dockX = parseFloat(term?.getAttribute('x') ?? '0');
        const dockY = parseFloat(term?.getAttribute('y') ?? '0');
        reveals[key] = { path, total, lens, costs, dockX, dockY };
      });
    };

    const updateReveal = () => {
      const on = revealOn();
      const scrolled = Math.max(0, -spineContainer.getBoundingClientRect().top);
      (['pro', 'indie', 'pers'] as const).forEach((key) => {
        const r = reveals[key];
        const term = lineTerminators[key];
        const ind = lineIndicators[key];
        if (!r) return;
        if (!on) {
          r.path.style.strokeDasharray = '';
          r.path.style.strokeDashoffset = '';
          if (term) {
            term.style.opacity = '';
            term.removeAttribute('transform');
            term.setAttribute('x', String(r.dockX));
            term.setAttribute('y', String(r.dockY));
          }
          if (ind) ind.style.opacity = '';
          return;
        }
        const reach = r.costs[0] + scrolled * LEAD;
        let drawn = 0;
        for (let i = 0; i < r.costs.length && r.costs[i] <= reach; i++) drawn = r.lens[i];
        r.path.style.strokeDasharray = `${r.total} ${r.total}`;
        r.path.style.strokeDashoffset = String(r.total - drawn);
        // The end cap is the train: it leaves once the line starts, rides the
        // tip turned along the track, and docks where it always sat.
        if (term) {
          if (drawn <= 0) {
            term.style.opacity = '0';
          } else if (drawn >= r.total - 1) {
            term.style.opacity = '1';
            term.removeAttribute('transform');
            term.setAttribute('x', String(r.dockX));
            term.setAttribute('y', String(r.dockY));
          } else {
            const tip = r.path.getPointAtLength(drawn);
            const back = r.path.getPointAtLength(Math.max(0, drawn - 3));
            const angle = (Math.atan2(tip.y - back.y, tip.x - back.x) * 180) / Math.PI;
            term.style.opacity = '1';
            term.setAttribute('x', String(tip.x - 7));
            term.setAttribute('y', String(tip.y - 4));
            term.setAttribute('transform', `rotate(${angle.toFixed(1)} ${tip.x.toFixed(1)} ${tip.y.toFixed(1)})`);
          }
        }
        if (ind) {
          const y = parseFloat(ind.getAttribute('y') ?? '0');
          ind.style.opacity = r.path.getPointAtLength(drawn).y >= y ? '1' : '0';
        }
      });
    };

    const draw = () => {
      sizeSpineSvg();
      placeSpineGeometry();
      regenerateBranchLines();
      measureReveals();
      updateReveal();
    };

    let revealTicking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (revealTicking) return;
        revealTicking = true;
        requestAnimationFrame(() => {
          revealTicking = false;
          updateReveal();
        });
      },
      { passive: true, signal },
    );

    draw();

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => requestAnimationFrame(draw));
    }

    let resizeTimeout: ReturnType<typeof setTimeout> | undefined;
    const onResize = () => {
      if (resizeTimeout) clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(draw, 100);
    };
    window.addEventListener('resize', onResize, { signal });
    resizeObserver = new ResizeObserver(onResize);
    resizeObserver.observe(spineContainer);

    // Accordion toggle requests an undebounced redraw on every animation
    // frame during its 420ms max-height transition so branch lines stay
    // glued to the moving section headers.
    window.addEventListener('spine:redraw', draw, { signal });

    signal.addEventListener('abort', () => {
      resizeObserver?.disconnect();
      resizeObserver = null;
      if (resizeTimeout) clearTimeout(resizeTimeout);
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
