---
---

<div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
  <button class="lightbox-close" type="button" aria-label="Close">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous image" hidden>
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <div class="lightbox-stage">
    <img class="lightbox-img" alt="" draggable="false" />
    <div class="lightbox-meta" aria-live="polite">
      <h3 class="lightbox-title"></h3>
      <p class="lightbox-subtitle"></p>
      <p class="lightbox-count" hidden></p>
    </div>
  </div>
  <button class="lightbox-nav lightbox-next" type="button" aria-label="Next image" hidden>
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 0;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease;
  }

  .lightbox-close:hover {
    color: white;
  }

  /* Previous and next: 44px, either side of the image, for mouse and trackpad. Arrow keys and swipes do the same. */
  .lightbox-nav {
    position: absolute;
    top: 50%;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    border: 0;
    border-radius: 50%;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .lightbox-nav[hidden] {
    display: none;
  }
  .lightbox-nav:hover {
    color: white;
    background: rgba(255, 255, 255, 0.16);
  }
  .lightbox-prev {
    left: 20px;
  }
  .lightbox-next {
    right: 20px;
  }
  .lightbox-close:focus-visible,
  .lightbox-nav:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }
  .lightbox-count {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 6px;
  }
  /* A short fade between images; none under reduced motion. */
  .lightbox-img {
    transition: opacity 0.12s ease-out;
  }
  .lightbox-img.is-changing {
    opacity: 0;
  }

  .lightbox-stage {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 4px;
    user-select: none;
    -webkit-user-drag: none;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .lightbox-meta {
    text-align: center;
  }

  .lightbox-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: white;
    text-transform: uppercase;
  }

  .lightbox-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 4px;
  }

  @media (max-width: 767px) {
    .lightbox {
      padding: 16px;
    }

    .lightbox-close {
      top: 12px;
      right: 12px;
    }
    /* Phones swipe; the buttons sit low, clear of the image, and stay for anyone who would rather tap. */
    .lightbox-nav {
      top: auto;
      bottom: 16px;
      margin-top: 0;
    }
    .lightbox-prev {
      left: 16px;
    }
    .lightbox-next {
      right: 16px;
    }
  }
  .lightbox {
    touch-action: pan-y pinch-zoom;
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox-img,
    .lightbox {
      transition: none;
    }
  }
</style>

<script>
  let controller: AbortController | null = null;

  // Back closes the viewer. Layout.astro registers a popstate listener ahead of the router's and calls this; stopping
  // the event there keeps the router from turning the back step into a page navigation.
  const w = window as unknown as { __lightboxPop?: (e: PopStateEvent) => void };

  function init() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const lb = document.getElementById('lightbox');
    if (!lb) return;
    const img = lb.querySelector('.lightbox-img') as HTMLImageElement;
    const title = lb.querySelector('.lightbox-title') as HTMLElement;
    const subtitle = lb.querySelector('.lightbox-subtitle') as HTMLElement;
    const count = lb.querySelector('.lightbox-count') as HTMLElement;
    const closeBtn = lb.querySelector('.lightbox-close') as HTMLButtonElement;
    const prevBtn = lb.querySelector('.lightbox-prev') as HTMLButtonElement;
    const nextBtn = lb.querySelector('.lightbox-next') as HTMLButtonElement;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    let set: HTMLElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;
    // True while the viewer's own history entry is the current one
    let pushed = false;

    const show = (i: number) => {
      index = (i + set.length) % set.length;
      const t = set[index];
      const apply = () => {
        img.src = t.getAttribute('data-lightbox-src') || '';
        const name = t.getAttribute('data-lightbox-title') || '';
        img.alt = name;
        title.textContent = name;
        subtitle.textContent = t.getAttribute('data-lightbox-subtitle') || '';
        count.textContent = set.length > 1 ? `${index + 1} / ${set.length}` : '';
        img.classList.remove('is-changing');
      };
      if (lb.classList.contains('is-open') && !reduced.matches) {
        img.classList.add('is-changing');
        setTimeout(apply, 120);
      } else apply();
    };

    const open = (trigger: HTMLElement) => {
      const group = trigger.closest('[data-lightbox-group]');
      set = group ? Array.from(group.querySelectorAll<HTMLElement>('[data-lightbox-src]')) : [trigger];
      if (!set.includes(trigger)) set = [trigger];
      opener = trigger;
      const many = set.length > 1;
      prevBtn.hidden = !many;
      nextBtn.hidden = !many;
      count.hidden = !many;
      show(set.indexOf(trigger));
      lb.classList.add('is-open');
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // An entry of its own, so the phone's back gesture closes the viewer instead of leaving the page
      try {
        history.pushState({ ...(history.state || {}), lightbox: true }, '');
        pushed = true;
      } catch {
        pushed = false;
      }
      closeBtn.focus();
    };

    const shut = () => {
      lb.classList.remove('is-open');
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      opener?.focus();
      opener = null;
    };

    // Every close goes through history when the viewer pushed an entry, so back and close end in the same place
    const close = () => {
      if (!lb.classList.contains('is-open')) return;
      if (pushed && history.state?.lightbox) history.back();
      else shut();
    };

    w.__lightboxPop = (e) => {
      if (lb.classList.contains('is-open') && pushed) {
        e.stopImmediatePropagation();
        pushed = false;
        shut();
      } else if (e.state?.lightbox) {
        // Forward into a closed viewer's entry: nothing to show, and nothing for the router to do
        e.stopImmediatePropagation();
      }
    };

    document.addEventListener(
      'click',
      (e) => {
        const trigger = (e.target as HTMLElement)?.closest('[data-lightbox-src]') as HTMLElement | null;
        if (!trigger || lb.contains(trigger)) return;
        open(trigger);
      },
      { signal },
    );
    closeBtn.addEventListener('click', close, { signal });
    prevBtn.addEventListener('click', () => show(index - 1), { signal });
    nextBtn.addEventListener('click', () => show(index + 1), { signal });

    let swallowClick = false;
    lb.addEventListener(
      'click',
      (e) => {
        if (swallowClick) {
          swallowClick = false;
          return;
        }
        if (e.target === lb) close();
      },
      { signal },
    );

    document.addEventListener(
      'keydown',
      (e) => {
        if (!lb.classList.contains('is-open')) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          close();
        } else if (e.key === 'ArrowLeft' && set.length > 1) {
          e.preventDefault();
          show(index - 1);
        } else if (e.key === 'ArrowRight' && set.length > 1) {
          e.preventDefault();
          show(index + 1);
        } else if (e.key === 'Tab') {
          // Keep focus inside the viewer
          const stops = [prevBtn, nextBtn, closeBtn].filter((b) => !b.hidden);
          const at = stops.indexOf(document.activeElement as HTMLButtonElement);
          e.preventDefault();
          const next = e.shiftKey ? (at <= 0 ? stops.length - 1 : at - 1) : (at + 1) % stops.length;
          stops[next].focus();
        }
      },
      { signal },
    );

    // Swipe: a mostly sideways move of 48px or more turns the image
    let sx = 0;
    let sy = 0;
    let tracking = false;
    lb.addEventListener(
      'pointerdown',
      (e) => {
        if (e.pointerType === 'mouse' || set.length < 2) return;
        sx = e.clientX;
        sy = e.clientY;
        tracking = true;
      },
      { signal },
    );
    lb.addEventListener(
      'pointerup',
      (e) => {
        if (!tracking) return;
        tracking = false;
        const dx = e.clientX - sx;
        const dy = e.clientY - sy;
        if (Math.abs(dx) >= 48 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          swallowClick = true;
          show(index + (dx < 0 ? 1 : -1));
        }
      },
      { signal },
    );
    lb.addEventListener('pointercancel', () => (tracking = false), { signal });
  }

  document.addEventListener('astro:page-load', init);
</script>
