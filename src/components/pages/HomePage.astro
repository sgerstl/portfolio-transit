---
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import MapWallpaper from '../MapWallpaper.astro';
import Hero from '../hero/Hero.tsx';
import Spine from '../spine/Spine.astro';
import MobileSpine from '../spine/MobileSpine.astro';
import Section from '../cases/Section.astro';
import SectionHeader from '../cases/SectionHeader.astro';
import Cases from '../cases/Cases.astro';
import CaseCard from '../cases/CaseCard.astro';
import StationCard from '../cases/StationCard.astro';
import Accordion from '../cases/Accordion.astro';
import Lightbox from '../Lightbox.astro';
import DemoModal from '../DemoModal.astro';
import { CASES, SECTIONS, casesForLine } from '../../data/cases';
import { ui } from '../../lib/ui';

const heroFigures = Object.fromEntries(
  CASES.filter((c) => c.body?.heroMetric).map((c) => [c.slug, c.body!.heroMetric!]),
);
---

<Layout title={ui('siteTitle')} canonicalPath="/">
  <Header />

  <main class="page">
    <MapWallpaper />

    <div class="spine-container" id="cases">
      {/* In the page's flow, so the cases start in the right place from the first paint. A height measured by script
          moved them after load, which threw off restored scroll positions coming back from a case. */}
      <Hero client:load figures={heroFigures} />
      <Spine />
      <MobileSpine />

      {SECTIONS.map((section) => (
        <Section line={section.line}>
          <SectionHeader
            line={section.line}
            code={section.code}
            title={section.title}
            subtitle={section.subtitle}
          />
          <Cases>
            {casesForLine(section.line).map((c) => c.body ? (
              <StationCard
                slug={c.slug}
                name={c.name}
                tagline={c.tagline}
                line={c.line}
                body={c.body}
                ai={c.ai}
                demo={!!(c.detail?.demoUrl || c.body?.demoUrl)}
                readingMinutes={c.readingMinutes}
              />
            ) : (
              <CaseCard
                slug={c.slug}
                name={c.name}
                tagline={c.tagline}
                line={c.line}
                body={c.body}
                personal={c.personal}
                ai={c.ai}
                demo={!!c.detail?.demoUrl}
                readingMinutes={c.readingMinutes}
              />
            ))}
          </Cases>
        </Section>
      ))}
    </div>
  </main>

  <Accordion />
  <Lightbox />
  <DemoModal />
</Layout>
