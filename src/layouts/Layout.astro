---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import ContactFab from '../components/ContactFab.astro';
import { ui } from '../lib/ui';

interface Props {
  title?: string;
  // Keeps a page out of search results. Used by unlisted pages that are shared
  // by link only (e.g. /joy-experiment).
  noindex?: boolean;
  // Optional canonical-path override. Defaults to the current pathname.
  canonicalPath?: string;
}

const { title = ui('siteTitle'), canonicalPath, noindex = false } = Astro.props;

const site = 'https://ux.scottgerstl.com';
const ogTitle = ui('og.title');
const ogDesc = ui('og.description');

const canonicalUrl = `${site}${canonicalPath ?? Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=VT323&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDesc} />
    {/* Registered before the router's own popstate listener (inline scripts run while the head is parsed, module
        scripts after), so the gallery viewer can claim a back step and stop it before the router turns it into a page
        navigation. Lightbox.astro sets window.__lightboxPop. */}
    <script is:inline>
      if (!window.__lightboxPopWired) {
        window.__lightboxPopWired = true;
        window.addEventListener('popstate', function (e) {
          if (typeof window.__lightboxPop === 'function') window.__lightboxPop(e);
        });
      }
    </script>
    <ClientRouter />
    <Analytics />
    <script>
      document.addEventListener('contextmenu', (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.tagName === 'IMG' && !target.hasAttribute('data-allow-save')) {
          e.preventDefault();
        }
      });

      // Remember the page before this one, so a back link can tell whether going back in history returns the reader
      // to the home page.
      document.addEventListener('astro:page-load', () => {
        try {
          const cur = sessionStorage.getItem('nav:cur');
          if (cur !== location.pathname) {
            sessionStorage.setItem('nav:prev', cur ?? '');
            sessionStorage.setItem('nav:cur', location.pathname);
          }
        } catch {}
      });

      // A link marked data-back goes back in history when the reader came from the home page, so the router
      // crossfades and restores their scroll position, the same as the browser's back button. Landing on a case
      // directly, or a modified click, follows the link. Capture phase, so it runs before the router's handler.
      document.addEventListener(
        'click',
        (e) => {
          const a = (e.target as HTMLElement | null)?.closest?.('a[data-back]');
          if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          try {
            if (sessionStorage.getItem('nav:prev') === '/' && history.length > 1) {
              e.preventDefault();
              history.back();
            }
          } catch {}
        },
        true,
      );
    </script>
  </head>
  <body>
    <slot />
    <ContactFab />
  </body>
</html>
