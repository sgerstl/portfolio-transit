---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import ContactFab from '../components/ContactFab.astro';
import { ui } from '../lib/ui';

interface Props {
  title?: string;
  // Keeps a page out of search results. Used by unlisted pages that are shared
  // by link only (e.g. /joy-experiment).
  noindex?: boolean;
  // Optional canonical-path override. Defaults to the current pathname.
  canonicalPath?: string;
}

const { title = ui('siteTitle'), canonicalPath, noindex = false } = Astro.props;

const site = 'https://ux.scottgerstl.com';
const ogTitle = ui('og.title');
const ogDesc = ui('og.description');

const canonicalUrl = `${site}${canonicalPath ?? Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=VT323&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDesc} />
    {/* Registered before the router's own popstate listener (inline scripts run while the head is parsed, module
        scripts after), so the gallery viewer can claim a back step and stop it before the router turns it into a page
        navigation. Lightbox.astro sets window.__lightboxPop. */}
    <script is:inline>
      if (!window.__lightboxPopWired) {
        window.__lightboxPopWired = true;
        window.addEventListener('popstate', function (e) {
          if (typeof window.__lightboxPop === 'function') window.__lightboxPop(e);
        });
      }
    </script>
    <ClientRouter />
    <Analytics />
    <script>
      import { navigate } from 'astro:transitions/client';

      // Card hover wash (global.css, data-wash): note where the pointer came in, so the tint spreads from there.
      // Keyboard focus spreads it from the centre.
      const placeWash = (card: HTMLElement, x: number, y: number) => {
        card.style.setProperty('--wash-x', `${x}px`);
        card.style.setProperty('--wash-y', `${y}px`);
      };
      document.addEventListener('pointerover', (e) => {
        const card = (e.target as Element | null)?.closest?.<HTMLElement>('[data-wash]');
        if (!card || card.contains(e.relatedTarget as Node | null)) return;
        const r = card.getBoundingClientRect();
        placeWash(card, e.clientX - r.left, e.clientY - r.top);
      });
      document.addEventListener('focusin', (e) => {
        const card = (e.target as Element | null)?.closest?.<HTMLElement>('[data-wash]');
        if (!card || !(e.target as Element).matches(':focus-visible')) return;
        placeWash(card, card.offsetWidth / 2, card.offsetHeight / 2);
      });

      document.addEventListener('contextmenu', (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.tagName === 'IMG' && !target.hasAttribute('data-allow-save')) {
          e.preventDefault();
        }
      });


      // Remember the page before this one, so a back link can tell whether going back in history returns the reader
      // to the home page. Also note the history length on arrival: an embedded demo (an iframe) adds its own pages
      // to the tab's history, and then history.back() would step through the demo instead of leaving the page.
      let arrivalHistoryLength = history.length;
      // Only the top-level page keeps this record: a page of this site loaded inside a frame must not overwrite it.
      const topLevel = window.top === window;
      document.addEventListener('astro:page-load', () => {
        if (!topLevel) return;
        arrivalHistoryLength = history.length;
        try {
          const cur = sessionStorage.getItem('nav:cur');
          if (cur !== location.pathname) {
            sessionStorage.setItem('nav:prev', cur ?? '');
            sessionStorage.setItem('nav:cur', location.pathname);
          }
        } catch {}
      });

      // Leaving the home page: keep its scroll position, so a back link can put the reader there again.
      document.addEventListener('astro:before-preparation', (e) => {
        const from = (e as Event & { from?: URL }).from;
        if (topLevel && from?.pathname === '/') {
          try {
            sessionStorage.setItem('home:scrollY', String(Math.round(window.scrollY)));
          } catch {}
        }
      });

      // Back on the home page through a back link: restore that position as the new page goes in, before the
      // crossfade's picture of it is taken, so nothing jumps.
      document.addEventListener('astro:after-swap', () => {
        try {
          if (location.pathname === '/' && sessionStorage.getItem('home:restore') === '1') {
            sessionStorage.removeItem('home:restore');
            const y = Number(sessionStorage.getItem('home:scrollY') || 0);
            window.scrollTo({ left: 0, top: y, behavior: 'instant' });
          }
        } catch {}
      });

      // A link marked data-back returns the reader to the home page where they were, with the router's crossfade.
      // Untouched history: a true back, the same as the browser's button. If an embedded demo has added its own
      // pages, back would walk through those, so it navigates home instead and restores the saved position. Landing
      // on a case directly, or a modified click, follows the link. Capture phase, so it runs before the router.
      document.addEventListener(
        'click',
        (e) => {
          const a = (e.target as HTMLElement | null)?.closest?.('a[data-back]');
          if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          try {
            if (sessionStorage.getItem('nav:prev') !== '/') return;
            e.preventDefault();
            if (history.length === arrivalHistoryLength && history.length > 1) {
              history.back();
            } else {
              sessionStorage.setItem('home:restore', '1');
              navigate('/');
            }
          } catch {}
        },
        true,
      );
    </script>
  </head>
  <body>
    <slot />
    <ContactFab />
  </body>
</html>
