---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ContactFab from '../components/ContactFab.astro';
import { asLocale, localizePath, ui, type Locale } from '../lib/i18n';

interface Props {
  title?: string;
  // Optional canonical-path override for hreflang generation. If not provided,
  // we use the current pathname (stripped of /de prefix).
  canonicalPath?: string;
}

const locale: Locale = asLocale(Astro.currentLocale);
const { title = ui('siteTitle', locale), canonicalPath } = Astro.props;

const site = 'https://ux.scottgerstl.com';
const ogTitle = ui('og.title', locale);
const ogDesc = ui('og.description', locale);

// Build a canonical EN-form path (no /de prefix) so hreflang alternates can
// be derived deterministically.
const currentPath = canonicalPath ?? Astro.url.pathname.replace(/^\/de(\/|$)/, '/');
const enUrl = `${site}${localizePath(currentPath, 'en')}`;
const deUrl = `${site}${localizePath(currentPath, 'de')}`;
const canonicalUrl = `${site}${localizePath(currentPath, locale)}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=VT323&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <ClientRouter />
    <script>
      document.addEventListener('contextmenu', (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.tagName === 'IMG' && !target.hasAttribute('data-allow-save')) {
          e.preventDefault();
        }
      });
    </script>
  </head>
  <body>
    <slot />
    <ContactFab />
  </body>
</html>
