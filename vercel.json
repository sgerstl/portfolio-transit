{
  "redirects": [
    {
      "source": "/de",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/de/(.*)",
      "destination": "/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/stats/:path*",
      "destination": "https://umami-taupe-seven.vercel.app/:path*"
    }
  ]
}
