{
  "redirects": [
    {
      "source": "/de",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/de/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/stats/:path*",
      "destination": "https://umami-taupe-seven.vercel.app/:path*"
    }
  ]
}
